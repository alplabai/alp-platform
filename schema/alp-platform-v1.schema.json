{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alplabai/alp-platform/schema/alp-platform-v1.schema.json",
  "title": "Alp Platform manifest (alp-platform-v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "platform", "released", "components", "recorded", "validated_hw"],
  "properties": {
    "schema": { "const": "alp-platform-v1" },
    "platform": {
      "type": "string",
      "pattern": "^(\\d{2})\\.([1-9]|1[0-2])\\.(0|[1-9]\\d*)(-rc[1-9]\\d*)?$"
    },
    "released": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alp-sdk", "tan-cli", "alp-sdk-vscode", "gd32-bridge-firmware", "cc3501e-bridge-firmware"],
      "properties": {
        "alp-sdk": { "$ref": "#/$defs/component" },
        "tan-cli": { "$ref": "#/$defs/component" },
        "alp-sdk-vscode": { "$ref": "#/$defs/component" },
        "gd32-bridge-firmware": {
          "allOf": [{ "$ref": "#/$defs/component" }],
          "required": ["protocol"],
          "properties": { "protocol": { "type": "string", "pattern": "^\\d+\\.\\d+$" } }
        },
        "cc3501e-bridge-firmware": {
          "allOf": [{ "$ref": "#/$defs/component" }],
          "required": ["gpe_stamp", "gpe_floor"],
          "properties": {
            "gpe_stamp": { "$ref": "#/$defs/gpe" },
            "gpe_floor": { "$ref": "#/$defs/gpe" }
          }
        }
      }
    },
    "recorded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zephyr", "hal_alif", "yocto"],
      "properties": {
        "zephyr": { "type": "string", "minLength": 1 },
        "hal_alif": { "type": "string", "minLength": 1 },
        "yocto": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "renesas_bsp": { "type": "string", "minLength": 1 },
        "renesas_ai_sdk": { "type": "string", "minLength": 1 }
      }
    },
    "validated_hw": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["som", "rev"],
        "properties": {
          "som": { "type": "string", "pattern": "^E1M-(AEN|V2N|V2M)\\d+$" },
          "rev": { "type": "string", "pattern": "^[0-9]{4}-r[1-9][0-9]*$", "description": "Composed board revision as stored in the module EEPROM hw_rev field: <board_datecode>-<rev key>, e.g. 2626-r2" }
        }
      }
    },
    "bench_evidence": { "type": ["string", "null"] }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z][0-9A-Za-z.-]*)?$"
        }
      }
    },
    "gpe": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+\\.\\d+$" }
  }
}
